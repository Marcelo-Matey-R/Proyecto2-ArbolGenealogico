<Window
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="ProyectoDatos22.MainWindow"
Title="Menú Principal" Height="320" Width="420" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid Background="Black">
        <Border CornerRadius="10" Padding="16" Margin="20" BorderBrush="Black" BorderThickness="1" Background="Black">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
                <TextBlock Text="Proyecto: Árbol Genealógico" FontSize="18" FontWeight="Bold" TextAlignment="Center"  Margin="0,0,0,12" Foreground="White"/>
                <Button x:Name="BtnAddNode" Content="Añadir familiares" Height="40" Margin="0,0,0,8" Click="BtnAddNode_Click" Foreground="#FFFDFDFD" BorderBrush="Cyan" Background="{x:Null}"/>
                <Button x:Name="BtnMap" Content="Mapa" Height="40" Margin="0,0,0,8" Click="BtnMap_Click" Background="Black" BorderBrush="Cyan" Foreground="White"/>
                <Button x:Name="BtnStats" Content="Estadísticas" Height="40" Click="BtnStats_Click" BorderBrush="Cyan" Foreground="White" Background="Black"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

