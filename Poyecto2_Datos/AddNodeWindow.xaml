<Window x:Class="Poyecto2_Datos.AddNodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Añadir / Modificar Persona" Height="520" Width="900" WindowStartupLocation="CenterOwner" WindowState="Maximized" Background="Black">
    <Grid Margin="8" Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="221*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Formulario (col 0) -->
        <Border Grid.Column="0" Padding="10" BorderBrush="Cyan" BorderThickness="1" CornerRadius="6" Grid.RowSpan="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="White">
                <StackPanel>
                    <TextBlock Text="Añadir nuevo miembro" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="Nombre completo" />
                    <TextBox x:Name="TxtNombre" Margin="0,4,0,8" BorderBrush="Cyan" Foreground="Black"/>
                    <TextBlock Text="Cédula" />
                    <TextBox x:Name="TxtCedula" Margin="0,4,0,8" Foreground="Black" BorderBrush="Cyan"/>
                    <TextBlock Text="Fecha de nacimiento" />
                    <DatePicker x:Name="DpFechaNacimiento" Margin="0,4,0,8" Foreground="Black" BorderBrush="Cyan"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Edad:" VerticalAlignment="Center" Width="80"/>
                        <TextBox x:Name="TxtAge"
             Width="120"
             HorizontalAlignment="Left"
             MaxLength="3"
             PreviewTextInput="TxtAge_PreviewTextInput"
             DataObject.Pasting="TxtAge_Pasting"
             ToolTip="Ingrese la edad en años (sólo números). Si queda vacío se calculará desde la fecha de nacimiento." BorderBrush="Cyan" Foreground="White"
             />
                    </StackPanel>


                    <TextBlock Text="Coordenadas (Plus Code)" />
                    <DockPanel Margin="0,4,0,8">
                        <TextBox x:Name="TxtPlusCode" DockPanel.Dock="Left" Width="200" BorderBrush="Cyan"/>
                        <Button x:Name="BtnConvertPlusCode" Content="Convertir" Margin="8,0,0,0" Click="BtnConvertPlusCode_Click" Foreground="White" Background="Black" BorderBrush="Cyan"/>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="Lat:" Width="40"/>
                        <TextBlock x:Name="LblLat" Text="-" />
                        <TextBlock Text="    Lon:" Margin="12,0,0,0"/>
                        <TextBlock x:Name="LblLon" Text="-" />
                    </StackPanel>

                    <TextBlock Text="Notas / Descripción (opcional)" />
                    <TextBox x:Name="TxtNotes" Height="80" AcceptsReturn="True" Margin="0,4,0,8" BorderBrush="Cyan"/>

                    <TextBlock Text="Relaciones (opcional): seleccionar padre/madre si existe en el árbol" FontStyle="Italic" Margin="0,6,0,2"/>
                    <ComboBox x:Name="CmbParent" Margin="0,4,0,8" IsEditable="False" SelectedIndex="0" DisplayMemberPath="familiar.name" BorderBrush="Cyan"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,8">
                        <Border BorderBrush="#CCC" BorderThickness="1" Width="120" Height="120" CornerRadius="6" Margin="0,0,12,0">
                            <Image x:Name="ImgPhoto" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel>
                            <Button x:Name="BtnLoadPhoto" Content="Cargar foto" Width="120" Click="BtnLoadPhoto_Click" Background="Black" BorderBrush="Cyan" Foreground="White"/>
                            <Button x:Name="BtnClearPhoto" Content="Quitar foto" Width="120" Margin="0,8,0,0" Click="BtnClearPhoto_Click" Foreground="White" Background="Black" BorderBrush="Cyan"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Pareja:" VerticalAlignment="Center" Width="80"/>
                        <ComboBox x:Name="CmbPartnerSelect"
              Width="300"
              HorizontalAlignment="Left"
              DisplayMemberPath="familiar.name"
              SelectedValuePath="familiar.id"
              IsEditable="False" BorderBrush="Cyan"/>
                    </StackPanel>

                    <!-- BOTONES: Guardar / Cancelar / Regresar -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Regresar" Width="120" Margin="6,0" Click="BtnBack_Click" BorderBrush="Cyan" Background="Black" Foreground="White" />
                        <Button Content="Cancelar" Width="120" Margin="6,0" Click="BtnCancel_Click" Foreground="White" BorderBrush="Cyan" Background="Black"/>
                        <Button Content="Guardar" Width="120" Margin="6,0" Click="BtnSave_Click" Background="Black" BorderBrush="Cyan" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- spacer columna 1 -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Black" Margin="3,0,3,0" Grid.RowSpan="2" />

        <!-- Visualización con Canvas (col 2) -->
        <Border Grid.Column="2" Padding="6" BorderBrush="#EEE" BorderThickness="1" CornerRadius="6" Grid.RowSpan="2">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="TreeCanvas" Background="Black" MinHeight="400" MinWidth="600"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
